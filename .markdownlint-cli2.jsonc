{
  // 取舍原则：只禁用「有明确理由、且仓库当前确实会触发」的规则；每条都写原因，
  // 不把 lint 报错当噪音关掉。未列出的规则一律按默认（启用）处理。
  // 注意：markdownlint 的值是「规则参数」而非「严重级」，启用规则用 true，不要写 2。
  // globs 写在这里而不是 package.json：否则不带参数直接跑 markdownlint-cli2
  // （编辑器插件、临时命令）会 lint 0 个文件并退出 0，看起来像通过。
  "globs": ["**/*.md"],
  "config": {
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false, // 中文按字符计却占两列，80 列对中文无意义；Prettier 不重排 Markdown 正文（proseWrap 默认 preserve）
    "MD024": { "siblings_only": true }, // CHANGELOG 每个版本都会重复「### 新增」；同级标题仍会被抓重
    "MD035": { "style": "---" },
    "MD041": false, // .github/PULL_REQUEST_TEMPLATE.md 首行是二级标题；CLAUDE.md 全文只有一行 @AGENTS.md 导入
    // 统一官方产品名大小写；code_blocks 关掉，命令与 URL 里的写法不受约束
    "MD044": {
      "names": [
        "GitHub",
        "Next.js",
        "Node.js",
        "ESLint",
        "Prettier",
        "Tailwind CSS",
        "TypeScript",
        "shadcn/ui",
      ],
      "code_blocks": false,
    },
    "MD046": { "style": "fenced" },
  },
  "ignores": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "**/*.tsbuildinfo",
    // git worktree 隔离工作区：里面有一份完整的 node_modules，扫进来会 lint 上千个第三方 .md
    ".worktrees/**",
  ],
}
