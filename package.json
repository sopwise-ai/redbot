{
  "name": "redbot",
  "version": "0.1.0",
  "private": true,
  "description": "中文互联网优质信息源的极简入口：一个按钮，直达一个信息源。",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && npm run readme && next build",
    "start": "npx --yes serve@14 out -l 4173",
    "validate": "tsx scripts/validate.ts",
    "check:links": "tsx scripts/validate.ts --check-links",
    "readme": "tsx scripts/generate-readme.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#out\" \"#.next\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint:md && npm run validate && npm run test && npm run typecheck"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.63.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "markdownlint-cli2": "^0.24.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
