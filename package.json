{
  "name": "redbot",
  "version": "0.1.0",
  "private": true,
  "description": "中文网站精选清单，上网一站就够了：一页按钮直达各站榜单与列表页，支持按主题浏览、全站搜索与本地足迹。免费、开源、无广告、无追踪。",
  "license": "MIT",
  "author": "SopwiseAI (https://redbot.cc)",
  "homepage": "https://redbot.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sopwise-ai/redbot.git"
  },
  "bugs": {
    "url": "https://github.com/sopwise-ai/redbot/issues"
  },
  "keywords": [
    "website-directory",
    "navigation",
    "bookmarks",
    "curated-list",
    "hot-list",
    "chinese-web",
    "中文互联网",
    "nextjs",
    "static-site",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "predev": "npm run gen",
    "dev": "next dev",
    "gen": "tsx scripts/generate-topics.ts",
    "gen:check": "tsx scripts/generate-topics.ts --check",
    "build": "npm run gen && npm run validate && npm run readme && next build",
    "start": "serve out -l 4173 --no-clipboard",
    "clean": "node -e \"for (const p of ['.next','out','tsconfig.tsbuildinfo']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "validate": "tsx scripts/validate.ts",
    "check:links": "tsx scripts/validate.ts --check-links",
    "readme": "tsx scripts/generate-readme.ts",
    "stats": "tsx scripts/stats.ts",
    "readme:check": "tsx scripts/generate-readme.ts --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint:md && npm run lint && npm run gen:check && npm run validate && npm run readme:check && npm run test && npm run typecheck",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.63.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^21.0.4",
    "markdownlint-cli2": "^0.24.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
