{
  "name": "redbot",
  "version": "0.1.0",
  "private": true,
  "description": "中文互联网精选网站清单：挑过的，分好的，点得开的。免费开源、人工精选、无广告无跟踪。",
  "license": "MIT",
  "author": "SopwiseAI (https://redbot.cc)",
  "homepage": "https://redbot.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sopwise-ai/redbot.git"
  },
  "bugs": {
    "url": "https://github.com/sopwise-ai/redbot/issues"
  },
  "keywords": [
    "directory",
    "information-source",
    "nextjs",
    "static-site",
    "中文互联网"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && npm run readme && next build",
    "start": "serve out -l 4173 --no-clipboard",
    "clean": "node -e \"for (const p of ['.next','out','tsconfig.tsbuildinfo']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "validate": "tsx scripts/validate.ts",
    "check:links": "tsx scripts/validate.ts --check-links",
    "readme": "tsx scripts/generate-readme.ts",
    "readme:check": "tsx scripts/generate-readme.ts --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint:md && npm run lint && npm run validate && npm run readme:check && npm run test && npm run typecheck",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.63.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "happy-dom": "^21.0.4",
    "markdownlint-cli2": "^0.24.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
